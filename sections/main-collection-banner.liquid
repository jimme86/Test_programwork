<section class="collection-banner">
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-banner__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collectiebanner",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Toon beschrijving", "default": true }
  ]
}
{% endschema %}
