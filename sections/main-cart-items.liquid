<section class="cart-page page-width">
  <h1>Winkelwagen</h1>
  {%- if cart.item_count > 0 -%}
    {% form 'cart', cart, class: 'cart-page__form' %}
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Prijs</th>
            <th>Aantal</th>
            <th>Totaal</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="cart-table__row">
              <td class="cart-table__product">
                <a href="{{ item.url }}" class="cart-table__image">
                  {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="100" height="100">{%- endif -%}
                </a>
                <div>
                  <a href="{{ item.url }}" class="cart-table__title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}<p class="cart-table__variant">{{ item.variant.title }}</p>{%- endif -%}
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="cart-table__remove">Verwijderen</a>
                </div>
              </td>
              <td data-label="Prijs">{{ item.final_price | money }}</td>
              <td data-label="Aantal">
                <div class="quantity-selector">
                  <input type="number" name="updates[{{ forloop.index }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Aantal">
                </div>
              </td>
              <td data-label="Totaal">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart-page__footer">
        {%- if settings.show_free_shipping_bar -%}{% render 'free-shipping-bar' %}{%- endif -%}
        <div class="cart-page__summary">
          <div class="cart-page__subtotal">
            <span>Subtotaal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__note">Verzendkosten en kortingen worden berekend bij het afrekenen.</p>
          <div class="cart-page__actions">
            <button type="submit" name="update" class="button button--secondary">Winkelwagen bijwerken</button>
            <button type="submit" name="checkout" class="button button--accent">Afrekenen</button>
          </div>
        </div>
      </div>
    {% endform %}
  {%- else -%}
    <div class="cart-drawer__empty">
      <p>Je winkelwagen is leeg.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">Verder winkelen</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Winkelwagen", "settings": [] }
{% endschema %}
