{%- if section.settings.enable -%}
<section class="newsletter" style="background:{{ section.settings.background }};">
  <div class="page-width">
    <div class="newsletter__inner">
      <div class="newsletter__text">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {% form 'customer', class: 'newsletter__form' %}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success" role="status">Bedankt voor je aanmelding!</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__form-row">
            <label class="visually-hidden" for="NewsletterEmail">E-mailadres</label>
            <input type="email" id="NewsletterEmail" name="contact[email]" placeholder="jouw@email.nl" required class="input">
            <button type="submit" class="button button--accent">Aanmelden</button>
          </div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Sectie tonen", "default": true },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Blijf op de hoogte van onafhankelijke energie" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Meld je aan voor tips, nieuwe producten en exclusieve aanbiedingen." },
    { "type": "color", "id": "background", "label": "Achtergrondkleur", "default": "#0A2A20" }
  ]
}
{% endschema %}
