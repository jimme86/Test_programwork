<section class="collection-list">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="collection-list__grid">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ coll.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="collection-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ coll.title | escape }}" loading="lazy" width="500" height="500">
            {%- elsif coll.image -%}
              <img src="{{ coll.image | image_url: width: 500 }}" alt="{{ coll.title | escape }}" loading="lazy" width="500" height="500">
            {%- else -%}
              <div class="collection-card__placeholder">{% render 'icon', icon: 'sun' %}</div>
            {%- endif -%}
          </div>
          <span class="collection-card__title">{{ block.settings.title | default: coll.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Shop op categorie" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Alles voor jouw off-grid systeem, van los onderdeel tot complete set." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "title", "label": "Titel (optioneel override)" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel override)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "Zonnepanelen" } },
      { "type": "category", "settings": { "title": "Thuisbatterijen" } },
      { "type": "category", "settings": { "title": "Omvormers" } },
      { "type": "category", "settings": { "title": "Off-grid sets" } },
      { "type": "category", "settings": { "title": "Laden & omvormen" } },
      { "type": "category", "settings": { "title": "Accessoires" } }
    ]
  },
  "presets": [
    { "name": "Categorieën" }
  ]
}
{% endschema %}
