<section class="account-page page-width">
  <div class="account-page__narrow">
    <h1>Account aanmaken</h1>
    {% form 'create_customer' %}
      {%- if form.errors -%}
        <p class="form__message" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="form-row"><label for="FirstName">Voornaam</label><input type="text" id="FirstName" name="customer[first_name]" class="input" autocomplete="given-name"></div>
      <div class="form-row"><label for="LastName">Achternaam</label><input type="text" id="LastName" name="customer[last_name]" class="input" autocomplete="family-name"></div>
      <div class="form-row"><label for="Email">E-mail</label><input type="email" id="Email" name="customer[email]" class="input" required autocomplete="email"></div>
      <div class="form-row"><label for="CreatePassword">Wachtwoord</label><input type="password" id="CreatePassword" name="customer[password]" class="input" required autocomplete="new-password"></div>
      <button type="submit" class="button button--accent button--full">Account aanmaken</button>
      <div class="account-page__links">
        <a href="{{ routes.account_login_url }}">Al een account? Log in</a>
      </div>
    {% endform %}
  </div>
</section>
