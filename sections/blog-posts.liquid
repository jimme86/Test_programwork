{%- assign featured_blog = blogs[section.settings.blog] -%}
<section class="blog-posts">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if featured_blog -%}
        <a href="{{ featured_blog.url }}" class="link-with-icon">Alle artikelen {% render 'icon', icon: 'chevron-right' %}</a>
      {%- endif -%}
    </div>
    <div class="blog-posts__grid">
      {%- if featured_blog -%}
        {%- for article in featured_blog.articles limit: section.settings.posts_to_show -%}
          <a href="{{ article.url }}" class="blog-card">
            <div class="blog-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 500 }}" alt="{{ article.title | escape }}" loading="lazy" width="500" height="333">
              {%- else -%}
                <div class="collection-card__placeholder">{% render 'icon', icon: 'sun' %}</div>
              {%- endif -%}
            </div>
            <p class="blog-card__date">{{ article.published_at | date: '%d %B %Y' }}</p>
            <h3 class="blog-card__title">{{ article.title }}</h3>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog / kennisbank",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Kennisbank & nieuws" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Alles over zonnepanelen, accu's en off-grid leven." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "label": "Aantal artikelen", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Blog / kennisbank" }
  ]
}
{% endschema %}
