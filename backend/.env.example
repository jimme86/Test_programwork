# Copy this file to backend/.env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# --- Social media auto-posting (backend/social/publisher.py) ---
# Only needed once the accounts + developer apps exist. See README.md's
# "Social Media Automation" section for how to obtain each of these.
# For the *scheduled agent run* to see these (not just your local shell),
# set them in this Claude Code Environment's configuration, not just here.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
