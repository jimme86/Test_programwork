<section class="usp-bar">
  <div class="page-width">
    <ul class="usp-bar__list">
      {%- for block in section.blocks -%}
        <li class="usp-bar__item" {{ block.shopify_attributes }}>
          <span class="usp-bar__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <div>
            <p class="usp-bar__title">{{ block.settings.title }}</p>
            <p class="usp-bar__text">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "USP-balk",
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          {"value":"truck","label":"Vrachtwagen"},
          {"value":"shield","label":"Schild"},
          {"value":"tool","label":"Gereedschap"},
          {"value":"battery","label":"Batterij"},
          {"value":"sun","label":"Zon"}
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Snelle levering" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Binnen enkele dagen in huis" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "usp", "settings": { "icon": "truck", "title": "Snelle levering", "text": "In heel NL & BE" } },
      { "type": "usp", "settings": { "icon": "shield", "title": "800+ installaties", "text": "Bewezen kwaliteit" } },
      { "type": "usp", "settings": { "icon": "tool", "title": "Plug-and-play", "text": "Voorbekabeld geleverd" } },
      { "type": "usp", "settings": { "icon": "battery", "title": "Victron & Hithium", "text": "A-merk componenten" } }
    ]
  },
  "presets": [
    { "name": "USP-balk" }
  ]
}
{% endschema %}
