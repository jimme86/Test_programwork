<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        {%- if settings.logo -%}
          <img
            src="{{ settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="140"
            height="{{ 140 | divided_by: settings.logo.aspect_ratio | round }}"
            class="site-footer__logo"
          >
        {%- else -%}
          <h3>{{ shop.name }}</h3>
        {%- endif -%}
        <p>{{ section.settings.about_text }}</p>
        <ul class="site-footer__social">
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">Facebook</a></li>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">Instagram</a></li>{%- endif -%}
          {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin }}" aria-label="LinkedIn">LinkedIn</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" aria-label="YouTube">YouTube</a></li>{%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-footer__col site-footer__col--contact">
        <h4>Contact</h4>
        <ul class="site-footer__contact">
          {%- if settings.phone_number != blank -%}
            <li><a href="tel:{{ settings.phone_number | remove: ' ' }}">{% render 'icon', icon: 'phone' %} {{ settings.phone_number }}</a></li>
          {%- endif -%}
          {%- if settings.email_address != blank -%}
            <li><a href="mailto:{{ settings.email_address }}">{% render 'icon', icon: 'mail' %} {{ settings.email_address }}</a></li>
          {%- endif -%}
          {%- if settings.address != blank -%}
            <li>{% render 'icon', icon: 'pin' %} {{ settings.address }}</li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle rechten voorbehouden.</p>
      <ul class="site-footer__payment">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Over ons tekst",
      "default": "Specialist in onafhankelijke energie: zonnepanelen, thuisbatterijen en complete off-grid systemen voor huis, camper en boot."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Linklijst",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Winkel" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Winkel" } },
      { "type": "link_list", "settings": { "heading": "Service" } }
    ]
  }
}
{% endschema %}
