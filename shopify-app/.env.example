# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_product_listings
SHOPIFY_APP_URL=https://REPLACE_WITH_YOUR_APP_URL
SHOP_CUSTOM_DOMAIN=offgrid-lifestyle.com

# 32-byte (64 hex chars) key used to encrypt social access/refresh tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook + Instagram Graph API / Commerce Manager) ---
# From developers.facebook.com > your app > Settings > Basic
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://REPLACE_WITH_YOUR_APP_URL/app/connections/meta/callback
# Business Manager Commerce Manager catalog id product updates are pushed to
META_CATALOG_ID=

# --- TikTok for Business (TikTok Shop + Content Posting API) ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://REPLACE_WITH_YOUR_APP_URL/app/connections/tiktok/callback
TIKTOK_SHOP_ID=

# --- Google / YouTube (OAuth client from Google Cloud Console) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://REPLACE_WITH_YOUR_APP_URL/app/connections/youtube/callback
