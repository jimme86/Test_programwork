<section class="account-page page-width">
  <div class="account-page__narrow">
    <h1>Nieuw wachtwoord instellen</h1>
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}<p class="form__message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="form-row"><label for="ResetPassword">Nieuw wachtwoord</label><input type="password" id="ResetPassword" name="customer[password]" class="input" required></div>
      <div class="form-row"><label for="ResetPasswordConfirm">Bevestig wachtwoord</label><input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" class="input" required></div>
      <button type="submit" class="button button--accent button--full">Wachtwoord opslaan</button>
    {% endform %}
  </div>
</section>
