<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% render 'meta-tags' %}
  <title>{{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  {%- style -%}
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-primary-dark: {{ settings.color_primary_dark }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-dark: {{ settings.color_accent_dark }};
      --color-background: {{ settings.color_background }};
      --color-background-alt: {{ settings.color_background_alt }};
      --color-text: {{ settings.color_text }};
      --color-text-light: {{ settings.color_text_light }};
      --color-border: {{ settings.color_border }};
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.corner_radius }};
      --font-heading-family: {{ settings.font_heading.family }}, sans-serif;
      --font-body-family: {{ settings.font_body.family }}, sans-serif;
    }
  {%- endstyle -%}
</head>
<body class="template-password">
  <div class="password-page">
    <div class="password-page__inner">
      {% if settings.logo %}
        <img
          src="{{ settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="180"
          height="{{ 180 | divided_by: settings.logo.aspect_ratio | round }}"
          style="margin-bottom:24px;"
        >
      {% else %}
        <h1 class="password-page__logo">{{ shop.name }}</h1>
      {% endif %}

      <h2>Binnenkort online</h2>
      <p>{{ shop.name }} is hard bezig met de nieuwe webshop voor onafhankelijke energie. We zijn er bijna.</p>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form__message" role="alert">Onjuist wachtwoord, probeer het opnieuw.</p>
        {%- endif -%}
        <div class="password-page__form-row">
          <input type="password" name="password" placeholder="Wachtwoord" class="input">
          <button type="submit" class="button button--primary">Openen</button>
        </div>
      {%- endform -%}

      {% if shop.password_message != blank %}
        <div class="password-page__message">{{ shop.password_message }}</div>
      {% endif %}
    </div>
  </div>
</body>
</html>
